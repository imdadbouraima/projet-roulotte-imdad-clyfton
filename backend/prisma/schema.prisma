generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La base locale du projet est un fichier SQLite.
datasource db {
  provider = "sqlite"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// Étapes possibles du traitement d'une commande.
enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
}

// Un compte peut être client, membre de la cuisine ou administrateur.
model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  name         String
  passwordHash String
  role         Role   @default(CUSTOMER)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// L'ordre des catégories affichées est contrôlé par position.
model Category {
  id       Int    @id @default(autoincrement())
  name     String @unique
  position Int

  dishes Dish[]
}

// Un plat appartient à une catégorie et peut avoir plusieurs allergènes.
model Dish {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @default("")
  priceCents  Int
  available   Boolean @default(true)
  stock       Int?
  imageUrl    String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  allergens  Allergen[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Les codes d'allergènes sont uniques et servent aux filtres de la carte.
model Allergen {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String

  dishes Dish[]
}

// Une commande appartient à un client et contient plusieurs lignes.
model Order {
  id         Int         @id @default(autoincrement())
  status     OrderStatus @default(RECEIVED)
  note       String?
  totalCents Int

  userId Int
  user   User @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Une ligne mémorise le prix au moment de la commande, même si le menu change après.
model OrderItem {
  quantity       Int
  unitPriceCents Int

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId Int
  dish   Dish @relation(fields: [dishId], references: [id])

  @@id([orderId, dishId])
}
