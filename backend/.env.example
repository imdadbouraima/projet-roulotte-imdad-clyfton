# Port HTTP utilisé par l'API.
PORT=3000

# Base SQLite locale créée dans le dossier backend.
DATABASE_URL="file:./dev.db"

# Clé de signature JWT : remplace cette valeur avant tout déploiement.
JWT_SECRET="remplacer_par_une_cle_secrete_longue"

# Durée de validité des jetons de connexion.
JWT_EXPIRES_IN="2h"

# Origine du site autorisée par CORS.
CORS_ORIGIN="http://localhost:5173"

# Adresse du simulateur de paiement fourni avec le projet.
PAYMENT_URL="http://localhost:4010"

# Clé de test du simulateur fourni ; ne pas remplacer par une clé de paiement réelle.
PAYMENT_API_KEY="sk_test_roulotte"